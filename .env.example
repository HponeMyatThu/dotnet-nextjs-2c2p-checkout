# ============================================================
# 2C2P / Payment Gateway credentials (required)
# ============================================================
TWOC2P_MERCHANT_ID=JT01
TWOC2P_SECRET_KEY=<your-secret-key>
TWOC2P_BASE_URL=https://sandbox-pgw.2c2p.com
TWOC2P_TIMEOUT_SECONDS=30

# Frontend & Backend return URLs
# When running locally without Docker:
TWOC2P_FRONTEND_RETURN_URL=http://localhost:3000/result
TWOC2P_BACKEND_RETURN_URL=http://localhost:5000/api/payments/2c2p/notification

# When running via Docker Compose (backend-to-backend):
# TWOC2P_BACKEND_RETURN_URL=http://backend:8080/api/payments/2c2p/notification

# ============================================================
# Database (MySQL 8)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payment_db
DB_USER=payment_user
DB_PASSWORD=<strong-password>
DB_ROOT_PASSWORD=<root-password>

# Full connection string (used directly in appsettings.json override)
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=payment_db;User=payment_user;Password=<password>;

# ============================================================
# Redis
# ============================================================
REDIS_CONNECTION_STRING=localhost:6379
# Redis__ConnectionString=localhost:6379

# ============================================================
# Frontend
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:5000
